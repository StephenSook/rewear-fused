# Force LF for all SHA-signed artifacts so manifest hashes are byte-stable across
# Windows (local build), Linux CI, and the Render deploy. CRLF conversion here
# silently breaks manifest SHA parity and the frozen-model verification gate.
data/artifacts/**       text eol=lf
data/datasets/**        binary

# JSON / data files: deterministic LF everywhere
*.json                  text eol=lf

# Python: LF (matches Linux CI + Render runtime)
*.py                    text eol=lf

# Dependency manifests: LF so the Render (Linux) build reads the same bytes we test
*.txt                   text eol=lf

# Parquet and other binaries: never touch
# NOTE: `data/artifacts/** text eol=lf` above would otherwise treat these binary
# structure files as text and CRLF->LF normalize them, corrupting the bytes (a
# .bcif/.cif with a 0x0D0A pair gets mangled). These binary rules come last so they win.
*.parquet               binary
*.cbm                   binary
*.pdb                   binary
*.bcif                  binary
*.cif                   binary
*.mmcif                 binary
*.mp4 binary
*.png binary
*.webm binary
