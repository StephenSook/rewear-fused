# REWEAR-FUSED environment template. Copy to .env (gitignored) and fill real values.
# Real secrets are NEVER committed. Ownership map below mirrors docs/secrets.md.

# ---- Frontend (Stephen, set in Vercel project env) ----
# Base URL of the signed artifact bundle (Cloudflare R2 / Vercel static)
NEXT_PUBLIC_ARTIFACTS_BASE_URL=https://artifacts.example.dev/v1.0.0
# Live Engine C classifier endpoint (Render)
NEXT_PUBLIC_ENGINE_C_API_URL=https://rewear-engine-c.onrender.com

# ---- Engine C (Vinh, set in Render service env) ----
# Optional LLM key for the RAG regulatory EXPLAINER only (never decides compliance)
ENGINE_C_LLM_API_KEY=
# Cloudflare R2 (artifact + dataset hosting)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rewear-artifacts

# ---- Keepalive cron (Vinh, GitHub Actions secret) ----
KEEPALIVE_TARGET_URL=https://rewear-engine-c.onrender.com/healthz

# ---- Backend molecular pipelines (Pravin, local + GPU host only) ----
RUNPOD_API_KEY=

# ---- Asset generation (Stephen, LOCAL ONLY, never in CI) ----
KIE_AI_API_KEY=
ELEVENLABS_API_KEY=
